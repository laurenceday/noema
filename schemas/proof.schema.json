{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema.invalid/schemas/proof.schema.json",
  "title": "Noema proof DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_digest", "root_node_ids", "nodes"],
  "properties": {
    "release_digest": { "$ref": "#/$defs/digest" },
    "root_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+#-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "claim_id", "rule_id", "premise_node_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["assertion", "rule"] },
        "claim_id": { "$ref": "#/$defs/identifier" },
        "rule_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "premise_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
