#!/usr/bin/env python3
"""Run the public Noema demonstration with a private stdin question path."""

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DOMAIN = ROOT / "domains" / "iana-owl2-rl"
QUESTION = (
    "Is application/problem+json a registered media type whose representation "
    "follows JSON syntax?"
)


def _run(arguments: list[str], display: str, *, stdin: str | None = None) -> None:
    print(f"$ {display}", flush=True)
    environment = os.environ.copy()
    environment["UV_NO_SYNC"] = "1"
    completed = subprocess.run(
        arguments,
        cwd=ROOT,
        env=environment,
        input=stdin,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise SystemExit(completed.returncode)


def main() -> int:
    prefix = ["uv", "run", "--offline", "--locked", "noema"]
    relative_domain = "domains/iana-owl2-rl"
    with tempfile.TemporaryDirectory(prefix="noema-demo-") as temporary:
        answer = Path(temporary) / "answer.json"
        _run(
            [*prefix, "build", str(DOMAIN)],
            f"uv run --offline --locked noema build {relative_domain}",
        )
        _run(
            [*prefix, "ask", str(DOMAIN), "--stdin", "--out", str(answer)],
            (
                "uv run --offline --locked noema ask "
                f"{relative_domain} --stdin --out answer.json"
            ),
            stdin=QUESTION + "\n",
        )
        _run(
            [*prefix, "verify", str(DOMAIN), str(answer)],
            (
                "uv run --offline --locked noema verify "
                f"{relative_domain} answer.json"
            ),
        )
        _run(
            [*prefix, "probe", str(DOMAIN)],
            f"uv run --offline --locked noema probe {relative_domain}",
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
